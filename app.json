{
  "expo": {
    "name": "AllRun",
    "slug": "allrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "allrun",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.plss12.allrun",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-ios-dark.png",
        "tinted": "./assets/images/icon-ios-tinted.png"
      }
    },
    "android": {
      "package": "com.plss12.allrun",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "AllRun shows your photos so you can put your data on them.",
          "savePhotosPermission": "AllRun saves the images you create to your photos.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AllRun uses your location only to name the city where your activities started."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "plss12",
    "extra": {
      "eas": {
        "projectId": "eb232586-d530-4b6e-9def-f5eac837e75b"
      }
    }
  }
}
