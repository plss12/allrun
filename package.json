{
  "name": "allrun",
  "version": "1.0.0",
  "description": "Overlay your Strava runs and weekly, monthly or yearly summaries on your own photos with full design freedom.",
  "author": "Pedro Luis Soto Santos <pepoluis712@gmail.com>",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/plss12/allrun.git"
  },
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "npx expo-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache .",
    "check:fast": "npm run typecheck && npm run lint && jest --onlyChanged",
    "check": "npm run lint && npm run format:check && npm run typecheck && jest --ci && npx expo-doctor && expo export --platform ios --platform android",
    "brand": "node scripts/brand/build-brand.mjs",
    "icons": "node scripts/icons/build-sport-icons.mjs"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/bangers": "^0.4.1",
