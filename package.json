{
  "name": "allrun",
  "version": "1.0.0",
  "description": "Overlay your Strava runs and weekly, monthly or yearly summaries on your own photos with full design freedom.",
  "author": "Pedro Luis Soto Santos <pepoluis712@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plss12/allrun.git"
  },
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "npx expo-doctor"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/ui": "~58.0.19",
    "expo": "~58.0.12",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.21",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
