# Copy to .env and fill in. Variables prefixed with EXPO_PUBLIC_ are bundled into the app:
# never put secrets in them. The Strava client secret lives only in Supabase function secrets.

# Supabase project (ADR 012). The key is the publishable one (sb_publishable_...), which is public;
# never the secret one.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Strava API application (milestone 4); the client ID is public
EXPO_PUBLIC_STRAVA_CLIENT_ID=

# Sentry (milestone 5)
EXPO_PUBLIC_SENTRY_DSN=
